# Copy to EC2 as .env (never commit real secrets):
#   cp env.for-ec2.upload.example .env && nano .env && chmod 600 .env
#
# From Windows PC:
#   scp -i your-key.pem env.for-ec2.upload ubuntu@YOUR_EC2_IP:~/movie-server-project/.env

NODE_ENV=production
LOG_LEVEL=info

HOST=127.0.0.1
PORT=3000

# --- xvideos catalog URLs ---
HOME_BASE_URL=https://www.xvideos.com
# /best/current = this month (Aug 2026 → /best/2026-08). Or / for homepage, /new/1 for newest.
HOME_LIST_PATH=/best/current
HOME_BEST_AUTO_CURRENT_MONTH=true
MODELS_BASE_URL=https://www.xvideos.com
MODELS_LIST_PATH=/pornstars-index
TAGS_BASE_URL=https://www.xvideos.com
TAGS_LIST_PATH=/tags
CHANNELS_BASE_URL=https://www.xvideos.com
CHANNELS_LIST_PATH=/channels-index
MYANMAR_BASE_URL=https://www.xvideos.com
MYANMAR_LIST_PATH=/?k=myanmar
WATCH_BASE_URL=https://www.xvideos.com
WATCH_REFERER=https://www.xvideos.com/

SECTION_HOME_SITE=xvideos
SECTION_MODEL_SITE=xvideos
SECTION_CHANNEL_SITE=xvideos
SECTION_TAG_SITE=xvideos
SECTION_MYANMAR_SITE=xvideos
DETAIL_ALLOWED_HOSTS=xvideos.com

# Outbound HTTP (1GB VPS — keep concurrency modest)
REQUEST_TIMEOUT_MS=15000
REQUEST_RETRIES=3
REQUEST_RETRY_BASE_MS=1000
REQUEST_INTERVAL_MS=400
REQUEST_MAX_CONCURRENCY=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Pipeline
JSON_PAGE_SIZE=100
JSON_SCHEMA_VERSION=1
GENERATOR_VERSION=1.0.0
PIPELINE_MAX_HOME_PAGES=3
PIPELINE_MAX_MYANMAR_PAGES=3
PIPELINE_MAX_PARENT_PAGES=3
PIPELINE_MAX_CHILD_PAGES=3
PIPELINE_MAX_PARENTS_PER_RUN=30
PIPELINE_REFUSE_EMPTY_OVERWRITE=true
PIPELINE_SEQUENTIAL_SECTIONS=true
PIPELINE_SECTION_CONCURRENCY=1
PIPELINE_PARENT_CONCURRENCY=2
PIPELINE_SCHEDULED_SECTIONS=home,model,channel,tag
# false = myanmar runs on MYANMAR_SCHEDULER_CRON instead (recommended)
PIPELINE_SCHEDULE_INCLUDE_MYANMAR=false
OUTPUT_DIR=output
PREVIOUS_DIR=data/previous
CATALOG_LAYOUT=legacy
CATALOG_MIRROR_LEGACY=true
SKIP_UNCHANGED_JSON_WRITES=true

# Scheduler — main catalog once daily (01:00 UTC, after myanmar job)
SCHEDULER_ENABLED=true
SCHEDULER_CRON=0 1 * * *
SCHEDULER_TZ=UTC
START_SCHEDULER_WITH_SERVER=true

# Myanmar — daily scrape; uploads to GitHub only when page JSON changed
MYANMAR_SCHEDULER_ENABLED=true
MYANMAR_SCHEDULER_CRON=0 0 * * *

# --- SECRETS (fill on server only) ---
API_KEY=REPLACE_WITH_LONG_RANDOM_HEX_OR_QUOTED_SECRET
REQUIRE_API_KEY=true
ADMIN_API_KEY=REPLACE_WITH_DIFFERENT_ADMIN_SECRET
REQUIRE_ADMIN_KEY=true

GITHUB_TOKEN=
GITHUB_OWNER=steventoelay-cmd
GITHUB_REPO=movie-data
GITHUB_BRANCH=main
GITHUB_BASE_PATH=data
GITHUB_COMMIT_PREFIX=chore(catalog): sync
GITHUB_RETRIES=3
GITHUB_RETRY_BASE_MS=1500

# CORS — use your Flutter/web origin(s), not * in production
CORS_ORIGIN=https://YOUR_APP_ORIGIN
CORS_ALLOW_WILDCARD_IN_PRODUCTION=false
CORS_METHODS=GET,HEAD,OPTIONS
CORS_HEADERS=Content-Type,X-Api-Key,X-Request-Id,Authorization

# Security
RATE_LIMIT_DETAIL_MAX=120
RATE_LIMIT_DETAIL_WINDOW_MS=60000
RATE_LIMIT_STREAM_MAX=60
RATE_LIMIT_STREAM_WINDOW_MS=60000
RATE_LIMIT_HEALTH_MAX=300
RATE_LIMIT_HEALTH_WINDOW_MS=60000
RATE_LIMIT_ADMIN_MAX=10
RATE_LIMIT_ADMIN_WINDOW_MS=60000
REQUEST_JSON_LIMIT=100kb
REQUEST_URL_MAX_LENGTH=2048
REQUEST_TIMEOUT_MS_HTTP=30000
HEALTH_EXPOSE_METRICS=false
SSRF_BLOCK_PRIVATE_IPS=true
SSRF_BLOCK_LOCALHOST=true

# Caches
DETAIL_CACHE_TTL_MS=86400000
RELATED_CACHE_TTL_MS=86400000
CATALOG_SSD_CACHE_TTL_MS=86400000
CATALOG_SSD_CACHE_DIR=data/cache/catalog
RELATED_SSD_CACHE_DIR=data/cache/related
DETAIL_CACHE_DIR=data/cache/detail
DETAIL_CACHE_MAX_ENTRIES=2000
STREAM_CACHE_TTL_MS=21600000
STREAM_CACHE_GRACE_MS=60000
STREAM_CACHE_RAM_ONLY=true
STREAM_CACHE_DIR=data/cache/stream
STREAM_CACHE_MAX_ENTRIES=5000
STREAM_TIMEOUT_MS=15000
STREAM_RETRIES=2
STREAM_RETRY_BASE_MS=800
STREAM_PREFER_M3U8=true
STREAM_ALLOW_STALE_ON_FAILURE=true

HTML_CACHE_ENABLED=true
HTML_CACHE_TTL_MS=60000
HTML_CACHE_MAX_ENTRIES=500
CLEANUP_ENABLED=true
CLEANUP_CRON=0 * * * *
METRICS_ENABLED=true
METRICS_INTERVAL_MS=60000
LOG_MEMORY_STATS=true
LOG_RETENTION_DAYS=7
SHUTDOWN_TIMEOUT_MS=10000
