{
  "name": "movies-server-project",
  "version": "1.0.0",
  "description": "Production movies backend — scraper, catalog pipeline, detail API for Flutter",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/server.js",
    "scrape:demo": "node src/cli/scrapeDemo.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci --coverage --forceExit",
    "test:unit": "jest --runInBand tests/unit",
    "test:api": "jest --runInBand tests/api",
    "test:integration": "jest --runInBand tests/integration tests/failure",
    "test:load": "node scripts/runLoadTests.js",
    "test:legacy": "npm run test:pipeline && npm run test:detail && npm run test:stream && npm run test:perf && npm run test:security",
    "test:all": "npm test && npm run test:legacy",
    "test:scraper": "node src/cli/scrapeDemo.js --dry-run",
    "test:pipeline": "node src/cli/offlinePipelineCheck.js",
    "test:detail": "node src/cli/offlineDetailCheck.js",
    "test:stream": "node src/cli/offlineStreamCheck.js",
    "test:perf": "node src/cli/offlinePerfCheck.js",
    "test:security": "node src/cli/offlineSecurityCheck.js",
    "lint": "eslint \"src/**/*.js\" \"tests/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" \"tests/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\"",
    "pipeline": "node src/cli/runPipeline.js",
    "pipeline:home": "node src/cli/runPipeline.js --section=home",
    "pipeline:model": "node src/cli/runPipeline.js --section=model",
    "pipeline:channel": "node src/cli/runPipeline.js --section=channel",
    "pipeline:tag": "node src/cli/runPipeline.js --section=tag",
    "pipeline:myanmar": "node src/cli/runPipeline.js --section=myanmar",
    "pipeline:local": "node src/cli/runPipeline.js --no-upload",
    "scheduler": "node src/cli/runPipeline.js --schedule",
    "pm2:start": "pm2 start ecosystem.config.cjs --only movies-api --env production",
    "pm2:start:dev": "pm2 start ecosystem.config.cjs --only movies-api-dev",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --only movies-api --env production --update-env",
    "pm2:stop": "pm2 stop movies-api",
    "pm2:logs": "pm2 logs movies-api",
    "pm2:status": "pm2 status",
    "deploy:health": "bash deploy/scripts/health-check.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "helmet": "^8.3.0",
    "node-cron": "^3.0.3"
  },
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0"
  }
}
